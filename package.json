{
  "name": "gatecraft",
  "version": "1.0.0",
  "description": "A browser-based digital logic circuit simulator built with [p5.js](https://p5js.org/). Place logic gates, wire them together, toggle inputs, and watch signals propagate in real time — including support for sequential circuits like SR latches and T flip-flops.",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ci": "vitest run",
    "bench": "node tests/performance/logic.bench.js bench-results.json",
    "bench:ci": "node tests/performance/logic.bench.js bench-results.json",
    "bench:compare": "node scripts/compare-benchmarks.js baseline.json bench-results.json",
    "bench:baseline": "node tests/performance/logic.bench.js baseline.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aditya67539/GateCraft.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Aditya67539/GateCraft/issues"
  },
  "homepage": "https://github.com/Aditya67539/GateCraft#readme",
  "devDependencies": {
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "mitata": "^1.0.34"
  }
}
